---
import keytarCamisetaAzul from '../../assets/fotos/keytar-camiseta-azul.webp';
import { historia } from '../../data/content';
import Paper from '../ui/Paper.astro';
import Polaroid from '../ui/Polaroid.astro';
import Tape from '../ui/Tape.astro';
import TapeX from '../ui/TapeX.astro';
---

<section
  id="historia"
  class="sec sec--alt"
  data-stage="historia"
  aria-labelledby="historia-title"
>
  <div class="container historia__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="historia-title">{historia.titulo}</h2>
    </div>

    <div class="historia__grid">
      <div class="historia__sheet">
        <Tape class="historia__tape historia__tape--tl" angle={-34} />
        <Tape class="historia__tape historia__tape--tr" angle={32} />
        <Paper variant="ruled" rotate={0.6} class="historia__paper">
          <p class="historia__p">{historia.parrafos[0]}</p>
          <p class="historia__p historia__p--producer">{historia.productor}</p>
          <p class="historia__p">{historia.parrafos[1]}</p>
        </Paper>
      </div>

      <div class="historia__photo">
        <Polaroid
          src={keytarCamisetaAzul}
          widths={[300, 409]}
          sizes="(max-width: 760px) 75vw, 280px"
          rotate={-5}
          alt="Músico tocando un keytar blanco Roland, con camiseta azul y tatuajes en el antebrazo"
          class="historia__polaroid"
        />
      </div>
    </div>
  </div>
</section>

<style>
  #historia {
    overflow: hidden;
  }

  .historia__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
  }

  .historia__sheet {
    position: relative;
    width: 100%;
    max-width: 70ch;
  }

  .historia__sheet :global(.historia__tape--tl) {
    top: -0.45rem;
    left: -0.6rem;
    width: 5.25rem;
  }

  .historia__sheet :global(.historia__tape--tr) {
    top: -0.45rem;
    right: -0.6rem;
    width: 5.25rem;
  }

  .historia__sheet :global(.historia__paper) {
    padding-top: 0.8125rem;
    padding-bottom: 1.75rem;
  }

  .historia__p {
    line-height: 1.75rem;
    margin-bottom: 1.75rem;
    color: var(--c-ink);
  }

  .historia__p:last-child {
    margin-bottom: 0;
  }

  .historia__p--producer {
    font-size: var(--t-small);
    line-height: 1.75rem;
    color: var(--c-ink-soft);
  }

  .historia__photo {
    width: 100%;
    max-width: 275px;
    margin-inline: auto;
  }

  .historia__photo :global(.polaroid__photo) {
    max-width: 300px;
  }

  @media (min-width: 860px) {
    .historia__grid {
      grid-template-columns: minmax(0, 70ch) minmax(240px, 300px);
      justify-content: space-between;
      gap: var(--s-7);
    }

    .historia__photo {
      margin-inline: 0;
    }
  }
</style>
