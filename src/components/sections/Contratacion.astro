---
import { Picture } from 'astro:assets';
import retratoKeytar from '../../assets/fotos/retrato-keytar.jpg';
import cierre from '../../assets/muro/cierre.jpg';
import {
  EMAIL,
  PHONE_DISPLAY,
  SOCIALS,
  WHATSAPP_BOOKING_URL,
} from '../../config';
import { contratacion } from '../../data/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Paper from '../ui/Paper.astro';
import Tape from '../ui/Tape.astro';
import TapeX from '../ui/TapeX.astro';

const starPath =
  'M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.86L12 17.77 5.82 21 7 14.14 2 9.27l7.1-1.01L12 2z';
---

<section
  id="contratacion"
  class="sec contratacion"
  data-stage="contratacion"
  aria-labelledby="contratacion-title"
>
  <div class="contratacion__bg" aria-hidden="true">
    <Picture
      src={cierre}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1480]}
      sizes="100vw"
      width={cierre.width}
      height={cierre.height}
      alt=""
      loading="lazy"
      class="contratacion__bg-img"
    />
    <div class="contratacion__bg-overlay"></div>
  </div>

  <div class="container contratacion__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="contratacion-title">Contrata el show</h2>
    </div>

    <div class="contratacion__grid">
      <div class="contratacion__poster-col">
        <Paper variant="aged" rotate={-2} class="poster">
          <Tape class="poster__tape poster__tape--left" angle={-14} />
          <Tape class="poster__tape poster__tape--right" angle={12} />

          <div class="poster__inner">
            <p class="display poster__title">{contratacion.afiche.titulo}</p>

            <p class="display poster__band poster__band--top">
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="currentColor"
                aria-hidden="true"
                class="poster__star"
              >
                <path d={starPath}></path>
              </svg>
              <span>{contratacion.afiche.linea1}</span>
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="currentColor"
                aria-hidden="true"
                class="poster__star"
              >
                <path d={starPath}></path>
              </svg>
            </p>

            <div class="poster__photo">
              <Picture
                src={retratoKeytar}
                formats={['avif', 'webp']}
                widths={[240, 360, 480]}
                sizes="(max-width: 760px) 75vw, 300px"
                width={retratoKeytar.width}
                height={retratoKeytar.height}
                loading="lazy"
                alt="Retrato en blanco y negro de un músico con keytar, al estilo de afiche de se busca"
                class="poster__photo-img"
              />
            </div>

            <p class="display poster__band poster__band--bottom">
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="currentColor"
                aria-hidden="true"
                class="poster__star"
              >
                <path d={starPath}></path>
              </svg>
              <span>{contratacion.afiche.linea2}</span>
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="currentColor"
                aria-hidden="true"
                class="poster__star"
              >
                <path d={starPath}></path>
              </svg>
            </p>

            <p class="display poster__amount">{contratacion.afiche.monto}</p>
          </div>
        </Paper>
      </div>

      <div class="contratacion__panel">
        <Button
          href={WHATSAPP_BOOKING_URL}
          variant="primary"
          icon="whatsapp"
          external
          class="contratacion__cta"
        >
          Contrata el show por WhatsApp
        </Button>

        <div class="contratacion__contact">
          <div class="contratacion__person">
            <p class="display contratacion__name">
              {contratacion.contacto.nombre}
            </p>
            <p class="contratacion__role">{contratacion.contacto.cargo}</p>
          </div>

          <div class="contratacion__channels">
            <a href={`mailto:${EMAIL}`} class="contratacion__mail">
              <Icon name="mail" size={20} />
              <span>{EMAIL}</span>
            </a>
            <p class="contratacion__phone">{PHONE_DISPLAY}</p>
          </div>
        </div>

        <div class="contratacion__socials-group">
          <h3 class="display contratacion__socials-heading">
            {contratacion.redes}
          </h3>
          <ul class="contratacion__socials">
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener"
                    class="contratacion__social-link"
                  >
                    <Icon name={social.id} size={22} />
                    <span class="visually-hidden">
                      {social.label} de Cumbia De+Lito (se abre en otra pestaña)
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contratacion {
    position: relative;
    overflow: hidden;
  }

  .contratacion__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .contratacion__bg :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contratacion__bg :global(.contratacion__bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contratacion__bg-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--c-navy-900);
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  .contratacion__inner {
    position: relative;
    z-index: 1;
  }

  .contratacion__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .contratacion__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
    }
  }

  .contratacion__poster-col {
    display: flex;
    justify-content: center;
    padding-top: var(--s-3);
  }

  .contratacion :global(.poster) {
    width: 100%;
    max-width: 390px;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 2px solid rgb(21 25 49 / 0.32);
    border-radius: 2px 5px 3px 6px / 5px 2px 6px 3px;
    box-shadow:
      inset 0 0 28px rgb(21 25 49 / 0.22),
      inset 0 0 6px rgb(114 29 31 / 0.16),
      var(--sh-paper);
    color: var(--c-ink);
  }

  .contratacion :global(.poster__tape--left) {
    top: -0.75rem;
    left: 1.25rem;
    width: 5.5rem;
  }

  .contratacion :global(.poster__tape--right) {
    top: -0.75rem;
    right: 1.25rem;
    width: 5.5rem;
  }

  .poster__inner {
    display: grid;
    min-width: 0;
    gap: var(--s-3);
    text-align: center;
    padding: clamp(0.75rem, 2vw, 1.15rem);
    border: 1.5px solid rgb(21 25 49 / 0.55);
    border-radius: 3px 1px 4px 2px / 2px 4px 1px 3px;
  }

  .poster__title {
    font-size: clamp(2.25rem, 4.2vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--c-ink);
  }

  .poster__band {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-size: clamp(0.75rem, 1.25vw, 0.9375rem);
    letter-spacing: 0.05em;
    color: var(--c-ink);
    padding-block: var(--s-2);
  }

  .poster__band--top {
    border-bottom: 1.5px solid var(--c-ink);
  }

  .poster__band--bottom {
    border-top: 1.5px solid var(--c-ink);
  }

  .poster__star {
    flex-shrink: 0;
    color: var(--c-ink);
  }

  .poster__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--c-paper-aged);
  }

  .poster__photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .poster__photo :global(.poster__photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: grayscale(1) contrast(1.35) sepia(0.25);
    mix-blend-mode: multiply;
  }

  .poster__amount {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
  }

  .contratacion__panel {
    background-color: var(--c-navy-900);
    border: 1px solid var(--c-navy-700);
    box-shadow: var(--sh-paper);
    padding: clamp(1.75rem, 4.5vw, 3rem);
    display: grid;
    gap: var(--s-6);
  }

  .contratacion__panel :global(.contratacion__cta) {
    width: 100%;
    min-height: 60px;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    padding: 1.1rem 1.5rem;
  }

  .contratacion__contact {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--c-navy-700);
    border-bottom: 1px solid var(--c-navy-700);
  }

  .contratacion__person {
    display: grid;
    gap: var(--s-1);
  }

  .contratacion__name {
    font-size: var(--t-h3);
    color: var(--c-white);
  }

  .contratacion__role {
    color: var(--c-text-soft);
    font-size: var(--t-body);
  }

  .contratacion__channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  .contratacion__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    color: var(--c-white);
    font-weight: 600;
    text-decoration: underline;
    transition: color var(--dur-1) var(--ease-out);
  }

  .contratacion__mail:hover {
    color: var(--c-text-soft);
  }

  .contratacion__phone {
    color: var(--c-text-soft);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .contratacion__socials-group {
    display: grid;
    gap: var(--s-3);
  }

  .contratacion__socials-heading {
    font-size: var(--t-h3);
    color: var(--c-white);
  }

  .contratacion__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .contratacion__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--c-navy-800);
    border: 1px solid var(--c-navy-700);
    color: var(--c-white);
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .contratacion__social-link:hover {
    background-color: var(--c-red);
    border-color: var(--c-red);
    transform: translateY(-2px);
  }
</style>
