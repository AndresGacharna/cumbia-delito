---
import { Picture } from 'astro:assets';
import seBusca from '../../assets/fotos/se-busca.png';
import cierre from '../../assets/muro/cierre.jpg';
import {
  EMAIL,
  PHONE_DISPLAY,
  SOCIALS,
  WHATSAPP_BOOKING_URL,
} from '../../config';
import { contratacion } from '../../data/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import TapeX from '../ui/TapeX.astro';

---

<section
  id="contratacion"
  class="sec contratacion"
  data-stage="contratacion"
  aria-labelledby="contratacion-title"
>
  <div class="contratacion__bg" aria-hidden="true">
    <Picture
      src={cierre}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1480]}
      sizes="100vw"
      width={cierre.width}
      height={cierre.height}
      alt=""
      loading="lazy"
      class="contratacion__bg-img"
    />
    <div class="contratacion__bg-overlay"></div>
  </div>

  <div class="container contratacion__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="contratacion-title">Contrata el show</h2>
    </div>

    <div class="contratacion__grid">
      <div class="contratacion__poster-col">
        <Picture
          src={seBusca}
          formats={['avif', 'webp']}
          widths={[320]}
          sizes="(max-width: 899px) 90vw, 500px"
          width={seBusca.width}
          height={seBusca.height}
          loading="lazy"
          alt="Afiche de se busca: cantando o tocando, recompensa en efectivo de $1,000,000"
          class="poster-img"
        />
      </div>

      <div class="contratacion__panel">
        <Button
          href={WHATSAPP_BOOKING_URL}
          variant="primary"
          icon="whatsapp"
          external
          class="contratacion__cta"
        >
          Contrata el show por WhatsApp
        </Button>

        <div class="contratacion__contact">
          <div class="contratacion__person">
            <p class="display contratacion__name">
              {contratacion.contacto.nombre}
            </p>
            <p class="contratacion__role">{contratacion.contacto.cargo}</p>
          </div>

          <div class="contratacion__channels">
            <a href={`mailto:${EMAIL}`} class="contratacion__mail">
              <Icon name="mail" size={20} />
              <span>{EMAIL}</span>
            </a>
            <a href="tel:+573144817052" class="contratacion__phone">
              <span>{PHONE_DISPLAY}</span>
            </a>
          </div>
        </div>

        <div class="contratacion__socials-group">
          <h3 class="display contratacion__socials-heading">
            {contratacion.redes}
          </h3>
          <ul class="contratacion__socials">
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener"
                    class="contratacion__social-link"
                  >
                    <Icon name={social.id} size={22} />
                    <span class="visually-hidden">
                      {social.label} de Cumbia De+Lito (se abre en otra pestaña)
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contratacion__poster-col :global(.poster-img) {
    display: block;
    width: min(100%, 500px);
    height: auto;
    margin-inline: auto;
    transform: rotate(-2deg);
  }

  .contratacion {
    position: relative;
    overflow: hidden;
  }

  .contratacion__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .contratacion__bg :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contratacion__bg :global(.contratacion__bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contratacion__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(13 17 33 / 0.8) 0%,
      rgb(13 17 33 / 0.35) 45%,
      rgb(13 17 33 / 0.35) 100%
    );
  }

  .contratacion__inner {
    position: relative;
    z-index: 1;
  }

  .contratacion__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .contratacion__grid {
      grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
      gap: var(--s-7);
    }
  }

  .contratacion__poster-col {
    display: flex;
    justify-content: center;
    padding-top: var(--s-3);
  }

  .contratacion__panel {
    background-color: var(--c-navy-900);
    background-image: var(--tex-grain);
    border: 1px solid var(--c-navy-700);
    box-shadow: var(--sh-paper);
    padding: clamp(1.75rem, 4.5vw, 3rem);
    display: grid;
    gap: var(--s-6);
  }

  .contratacion__panel :global(.contratacion__cta) {
    width: 100%;
    min-height: 60px;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    padding: 1.1rem 1rem;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .contratacion__panel :global(.contratacion__cta svg) {
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .contratacion__panel :global(.contratacion__cta) {
      font-size: clamp(0.875rem, 1.35vw, 1.125rem);
      padding-inline: 1.25rem;
    }

    .contratacion__panel :global(.contratacion__cta .btn__label) {
      white-space: nowrap;
    }
  }

  .contratacion__contact {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--c-navy-700);
    border-bottom: 1px solid var(--c-navy-700);
  }

  .contratacion__person {
    display: grid;
    gap: var(--s-1);
  }

  .contratacion__name {
    font-size: var(--t-h3);
    color: var(--c-white);
  }

  .contratacion__role {
    color: var(--c-text-soft);
    font-size: var(--t-body);
  }

  .contratacion__channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  .contratacion__mail,
  .contratacion__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    color: var(--c-white);
    font-weight: 600;
    text-decoration: underline;
    transition: color var(--dur-1) var(--ease-out);
  }

  .contratacion__mail:hover,
  .contratacion__phone:hover {
    color: var(--c-text-soft);
  }

  .contratacion__phone {
    font-variant-numeric: tabular-nums;
  }

  .contratacion__socials-group {
    display: grid;
    gap: var(--s-3);
  }

  .contratacion__socials-heading {
    font-size: var(--t-h3);
    color: var(--c-white);
  }

  .contratacion__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .contratacion__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--c-navy-800);
    border: 1px solid var(--c-navy-700);
    color: var(--c-white);
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .contratacion__social-link:hover {
    background-color: var(--c-red);
    border-color: var(--c-red);
    transform: translateY(-2px);
  }
</style>
