---
import { lugarId, trayectoria } from '../../data/content';
import MapaGira from '../MapaGira.astro';
import Plus from '../ui/Plus.astro';
import TapeX from '../ui/TapeX.astro';
---

<section
  id="trayectoria"
  class="sec sec--alt"
  data-stage="trayectoria"
  aria-labelledby="trayectoria-title"
>
  <div class="container trayectoria__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="trayectoria-title">{trayectoria.titulo}</h2>
    </div>

    <div class="trayectoria__grid">
      <div class="trayectoria__map">
        <MapaGira />
        <p class="trayectoria__hint">
          Toca una marca para ver el lugar.
        </p>
      </div>

      <div class="trayectoria__body">
        <div class="trayectoria__group">
          <h3 class="display trayectoria__heading">
            Internacional
            <span class="trayectoria__count">{trayectoria.internacional.length} países</span>
          </h3>
          <ul class="trayectoria__list trayectoria__list--internacional" role="list">
            {
              trayectoria.internacional.map((pais) => (
                <li>
                  <button
                    type="button"
                    class="lugar display"
                    data-lugar={lugarId(pais)}
                    aria-pressed="false"
                  >
                    {pais}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="trayectoria__group">
          <h3 class="display trayectoria__heading">
            Colombia
            <span class="trayectoria__count">{trayectoria.colombia.length} ciudades</span>
          </h3>
          <ul class="trayectoria__list" role="list">
            {
              trayectoria.colombia.map((ciudad) => (
                <li>
                  <button
                    type="button"
                    class="lugar lugar--ciudad display"
                    data-lugar={lugarId(ciudad)}
                    aria-pressed="false"
                  >
                    <Plus size={12} class="lugar__plus" />
                    {ciudad}
                  </button>
                </li>
              ))
            }
            <li class="trayectoria__cierre display">{trayectoria.colombiaCierre}</li>
          </ul>
        </div>

        <p class="trayectoria__eventos">{trayectoria.eventos}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .trayectoria__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
    align-items: start;
  }

  @media (min-width: 900px) {
    .trayectoria__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--s-8);
    }

    .trayectoria__body {
      position: sticky;
      top: 6rem;
    }
  }

  .trayectoria__map {
    display: grid;
    gap: var(--s-3);
    max-width: 640px;
    width: 100%;
    margin-inline: auto;
  }

  .trayectoria__hint {
    font-size: var(--t-small);
    color: var(--c-text-soft);
    text-align: center;
  }

  .trayectoria__body {
    display: grid;
    gap: var(--s-6);
  }

  .trayectoria__group {
    display: grid;
    gap: var(--s-3);
  }

  .trayectoria__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 2px solid var(--c-red);
    font-size: var(--t-h3);
    letter-spacing: 0.06em;
    color: var(--c-white);
  }

  .trayectoria__count {
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: var(--c-text-soft);
  }

  .trayectoria__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .lugar {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    background-color: rgb(13 17 33 / 0.55);
    color: var(--c-white);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .trayectoria__list--internacional .lugar {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    padding-inline: 0.9rem;
  }

  .lugar:hover {
    border-color: var(--c-red);
  }

  .lugar[aria-pressed='true'] {
    background-color: var(--c-paper);
    border-color: var(--c-paper);
    color: var(--c-ink);
  }

  .lugar :global(.lugar__plus) {
    color: var(--c-red);
  }

  .trayectoria__cierre {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 0.4rem;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--c-text-soft);
  }

  .trayectoria__eventos {
    color: var(--c-text-soft);
    max-width: var(--measure);
  }
</style>
