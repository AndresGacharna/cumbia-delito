---
import duoKeytar from '../../assets/fotos/duo-keytar.jpg';
import { propuesta } from '../../data/content';
import Paper from '../ui/Paper.astro';
import Plus from '../ui/Plus.astro';
import Polaroid from '../ui/Polaroid.astro';
import Tape from '../ui/Tape.astro';
import TapeX from '../ui/TapeX.astro';
---

<section
  id="propuesta"
  class="sec"
  data-stage="propuesta"
  aria-labelledby="propuesta-title"
>
  <div class="container propuesta__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="propuesta-title">{propuesta.titulo}</h2>
    </div>

    <div class="propuesta__grid">
      <div class="propuesta__sheet">
        <Tape class="propuesta__tape" angle={-2} />
        <Paper variant="grid" rotate={-1} class="propuesta__paper">
          <div class="propuesta__copy">
            {propuesta.parrafos.map((parrafo) => <p>{parrafo}</p>)}
          </div>

          <div class="propuesta__sound">
            <h3 class="propuesta__sound-title display">Así suena</h3>
            <ul class="propuesta__sound-list" role="list">
              {
                propuesta.sonido.map((item) => (
                  <li class="propuesta__sound-item">
                    <Plus size={18} />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </Paper>
      </div>

      <div class="propuesta__photo">
        <Polaroid
          src={duoKeytar}
          rotate={3}
          tape="corners"
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 760px) 80vw, 34vw"
          alt="Dos músicos posando frente a un fondo naranja; uno lleva un keytar blanco y la camiseta de Cumbia De+Lito"
        />
      </div>
    </div>
  </div>
</section>

<style>
  #propuesta {
    overflow: hidden;
  }

  .propuesta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
  }

  .propuesta__sheet {
    position: relative;
    z-index: 1;
  }

  .propuesta__sheet :global(.propuesta__tape) {
    top: -0.9rem;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
  }

  .propuesta__sheet :global(.propuesta__paper) {
    display: grid;
    gap: var(--s-6);
  }

  .propuesta__copy {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
  }

  .propuesta__sound {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-paper-rule);
  }

  .propuesta__sound-title {
    font-size: var(--t-h3);
    color: var(--c-ink);
  }

  .propuesta__sound-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }

  .propuesta__sound-item {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-weight: 600;
    color: var(--c-ink);
  }

  .propuesta__sound-item :global(.plus-mark) {
    transform: translateY(3px);
  }

  .propuesta__photo {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: min(74vw, 380px);
    margin-inline: auto;
  }

  @media (min-width: 761px) {
    .propuesta__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
    }

    .propuesta__sheet {
      grid-column: 1 / 8;
    }

    .propuesta__photo {
      grid-column: 8 / 13;
      max-width: none;
      margin-left: calc(var(--s-5) * -1);
    }
  }
</style>
