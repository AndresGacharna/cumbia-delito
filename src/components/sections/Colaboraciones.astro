---
import eresMiCumbia from '../../assets/portadas/eres-mi-cumbia.jpg';
import pibeGanador from '../../assets/portadas/pibe-ganador.jpg';
import { colaboraciones, karolG } from '../../data/content';
import SpotifyFacade from '../embeds/SpotifyFacade.astro';
import YouTubeFacade from '../embeds/YouTubeFacade.astro';
import Icon from '../ui/Icon.astro';
import Paper from '../ui/Paper.astro';
import Polaroid from '../ui/Polaroid.astro';
import Tape from '../ui/Tape.astro';
import TapeX from '../ui/TapeX.astro';

const [subcantante, losVarriletes, losPibesDelPenal] = colaboraciones;
---

<section
  id="colaboraciones"
  class="sec"
  data-stage="colaboraciones"
  aria-labelledby="colaboraciones-title"
>
  <div class="container colab__inner">
    <div class="sec-head">
      <TapeX size={36} />
      <h2 id="colaboraciones-title">Colaboraciones</h2>
    </div>

    <div class="colab__karol">
      <p class="colab__karol-quote display">{karolG.texto}</p>
      <div class="colab__karol-video">
        <YouTubeFacade
          videoId={karolG.youtubeId}
          start={karolG.startSeconds}
          title="KAROL G – La Premiere"
          thumbnail={false}
        >
          <a
            slot="links"
            href={karolG.rcnUrl}
            target="_blank"
            rel="noopener"
            class="colab__rcn-link"
          >
            <span>Lee la nota en Noticias RCN</span>
            <Icon name="external" size={14} />
          </a>
        </YouTubeFacade>
      </div>
    </div>

    <div class="colab__strips">
      <!-- 1. Subcantante: notebook strip left + polaroid & Spotify right -->
      <article class="colab__row colab__row--subcantante">
        <div class="colab__strip-wrap colab__strip-wrap--left">
          <Tape class="colab__tape colab__tape--top-left" angle={-4} />
          <Paper variant="ruled" rotate={-0.8} class="colab__strip">
            <h3 class="colab__strip-title display">
              {subcantante.con} · {subcantante.obra}
            </h3>
            <YouTubeFacade
              videoId={subcantante.youtubeId!}
              title="Subcantante y Cumbia De+Lito – Eres Mi Cumbia"
              thumbnail={true}
            />
          </Paper>
        </div>

        <div class="colab__side-media colab__side-media--right">
          <div class="colab__cover">
            <Polaroid
              src={eresMiCumbia}
              widths={[240, 300]}
              sizes="(max-width: 600px) 70vw, 260px"
              rotate={2.5}
              tape="top"
              alt="Portada de Eres Mi Cumbia"
            />
          </div>
          <div class="colab__audio">
            <SpotifyFacade
              trackId={subcantante.spotifyTrackId!}
              title={subcantante.obra}
            />
          </div>
        </div>
      </article>

      <!-- 2. Los Varriletes: polaroid left + notebook strip with Spotify right -->
      <article class="colab__row colab__row--varriletes">
        <div class="colab__side-media colab__side-media--left">
          <div class="colab__cover">
            <Polaroid
              src={pibeGanador}
              widths={[240, 300]}
              sizes="(max-width: 600px) 70vw, 260px"
              rotate={-2.5}
              tape="corners"
              alt="Portada de Pibe Ganador, con las banderas de Argentina y Colombia"
            />
          </div>
        </div>

        <div class="colab__strip-wrap colab__strip-wrap--right">
          <Tape class="colab__tape colab__tape--top-right" angle={3} />
          <Paper variant="grid" rotate={1} class="colab__strip">
            <h3 class="colab__strip-title display">
              {losVarriletes.con} · {losVarriletes.obra}
            </h3>
            <SpotifyFacade
              trackId={losVarriletes.spotifyTrackId!}
              title={losVarriletes.obra}
            />
          </Paper>
        </div>
      </article>

      <!-- 3. Los Pibes Del Penal: wide notebook strip with heading + video -->
      <article class="colab__row colab__row--pibes">
        <div class="colab__strip-wrap colab__strip-wrap--wide">
          <Tape class="colab__tape colab__tape--tl" angle={-28} />
          <Tape class="colab__tape colab__tape--tr" angle={26} />
          <Paper variant="ruled" rotate={-0.5} class="colab__strip colab__strip--split">
            <h3 class="colab__strip-title display">
              {losPibesDelPenal.con} · {losPibesDelPenal.obra}
            </h3>
            <div class="colab__pibes-video">
              <YouTubeFacade
                videoId={losPibesDelPenal.youtubeId!}
                title="Amor a escondidas – Los Pibes Del Penal y Cumbia De+Lito"
                thumbnail={true}
              />
            </div>
          </Paper>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  #colaboraciones {
    overflow: hidden;
  }

  #colaboraciones-title {
    font-size: clamp(1.25rem, 5.2vw, 3.75rem);
  }

  .colab__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }

  .colab__inner :global(.sec-head) {
    margin-bottom: 0;
  }

  .colab__karol {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
  }

  .colab__karol-quote {
    font-size: calc(var(--t-h3) * 1.3);
    color: var(--c-white);
    line-height: 1.08;
    max-width: 46ch;
  }

  .colab__karol-video {
    width: 100%;
    max-width: 880px;
  }

  .colab__strips {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
  }

  .colab__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
  }

  .colab__strip-wrap {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .colab__strip-wrap :global(.colab__strip) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }

  .colab__strip-title {
    font-size: var(--t-h3);
    color: var(--c-ink);
  }

  .colab__strip-wrap :global(.colab__tape--top-left) {
    top: -0.85rem;
    left: 2rem;
  }

  .colab__strip-wrap :global(.colab__tape--top-right) {
    top: -0.85rem;
    right: 2rem;
  }

  .colab__strip-wrap :global(.colab__tape--tl) {
    top: -0.5rem;
    left: -0.6rem;
    width: 5.25rem;
  }

  .colab__strip-wrap :global(.colab__tape--tr) {
    top: -0.5rem;
    right: -0.6rem;
    width: 5.25rem;
  }

  .colab__side-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    justify-items: center;
    width: 100%;
  }

  .colab__cover {
    width: 100%;
    max-width: 280px;
  }

  .colab__cover :global(.polaroid__photo) {
    max-width: 300px;
  }

  .colab__audio {
    width: 100%;
    max-width: 280px;
  }

  @media (min-width: 820px) {
    .colab__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--s-6);
    }

    .colab__strip-wrap--left {
      grid-column: 1 / 8;
    }

    .colab__side-media--right {
      grid-column: 8 / 13;
    }

    .colab__side-media--left {
      grid-column: 1 / 6;
    }

    .colab__strip-wrap--right {
      grid-column: 6 / 13;
    }

    .colab__strip-wrap--wide {
      grid-column: 2 / 12;
    }

    .colab__strip-wrap :global(.colab__strip--split) {
      grid-template-columns: minmax(200px, 5fr) 7fr;
      align-items: center;
      gap: var(--s-6);
    }
  }
</style>
