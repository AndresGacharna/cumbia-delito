---
// Latin America drawn at build time from Natural Earth (world-atlas); the browser
// only receives the finished SVG paths plus a small script for pins and zoom.
import { geoArea, geoCentroid, geoMercator, geoPath } from 'd3-geo';
import type { Feature, FeatureCollection, MultiPolygon, Polygon, Position } from 'geojson';
import { feature } from 'topojson-client';
import { presimplify, simplify } from 'topojson-simplify';
import type { GeometryCollection, Topology } from 'topojson-specification';
import world from 'world-atlas/countries-50m.json';
import { lugarId, trayectoria, trayectoriaCoords } from '../data/content';
import Plus from './ui/Plus.astro';
import TapeX from './ui/TapeX.astro';

// Drop vertices whose triangle is under 0.003 deg² (a few km²): invisible even zoomed on Colombia.
const topo = simplify(
  presimplify(world as unknown as Topology<{ countries: GeometryCollection<{ name: string }> }>),
  3e-3,
) as Topology<{ countries: GeometryCollection<{ name: string }> }>;
const countries = feature(topo, topo.objects.countries).features;

const inRegion = ([lon, lat]: number[]): boolean =>
  lon > -120 && lon < -30 && lat > -60 && lat < 33;

// Keep only the polygons that sit in the region: this drops mainland France but
// keeps French Guiana, drops the USA, and skips specks too small to read.
type Country = Feature<MultiPolygon, { name: string }>;
const region: Country[] = countries.flatMap((country) => {
  const geometry = country.geometry as Polygon | MultiPolygon | null;
  if (!geometry) return [];
  const polygons: Position[][][] =
    geometry.type === 'Polygon' ? [geometry.coordinates] : geometry.coordinates;
  const kept = polygons.filter((coordinates) => {
    const polygon: Polygon = { type: 'Polygon', coordinates };
    return inRegion(geoCentroid(polygon)) && geoArea(polygon) > 1.5e-6;
  });
  if (kept.length === 0) return [];
  return [
    {
      type: 'Feature',
      id: country.id,
      properties: country.properties,
      geometry: { type: 'MultiPolygon', coordinates: kept },
    },
  ];
});

const collection: FeatureCollection<MultiPolygon> = {
  type: 'FeatureCollection',
  features: region,
};

const projection = geoMercator().fitWidth(1000, collection);
const path = geoPath(projection).digits(1);

type Box = { x: number; y: number; w: number; h: number };
const round = (box: Box): Box => ({
  x: Math.round(box.x * 10) / 10,
  y: Math.round(box.y * 10) / 10,
  w: Math.round(box.w * 10) / 10,
  h: Math.round(box.h * 10) / 10,
});

const [[x0, y0], [x1, y1]] = path.bounds(collection);
const pad = 14;
const full = round({ x: x0 - pad, y: y0 - pad, w: x1 - x0 + pad * 2, h: y1 - y0 + pad * 2 });
const aspect = full.w / full.h;

// Colombia view: the mainland (San Andrés would stretch the frame), padded and
// widened to the map's own aspect so pins map 1:1 onto the frame.
const COLOMBIA_ID = '170';
const colombia = region.find((country) => country.id === COLOMBIA_ID);
const mainland = colombia?.geometry.coordinates
  .map((coordinates) => ({ type: 'Polygon', coordinates }) as Polygon)
  .sort((a, b) => geoArea(b) - geoArea(a))[0];
const [[cx0, cy0], [cx1, cy1]] = mainland
  ? path.bounds(mainland)
  : [[full.x, full.y], [full.x + full.w, full.y + full.h]];
let focusW = (cx1 - cx0) * 1.16;
let focusH = (cy1 - cy0) * 1.1;
if (focusW / focusH < aspect) focusW = focusH * aspect;
else focusH = focusW / aspect;
const focus = round({
  x: (cx0 + cx1) / 2 - focusW / 2,
  y: (cy0 + cy1) / 2 - focusH / 2,
  w: focusW,
  h: focusH,
});

// Natural Earth ids (ISO 3166 numeric) of the countries the band has played.
const visitedIds = new Set([COLOMBIA_ID, '484', '218', '604', '032', '152']);
const land = region.map((country) => ({
  id: String(country.id),
  d: path(country) ?? '',
  visited: visitedIds.has(String(country.id)),
}));

const place = (name: string) => {
  const coords = trayectoriaCoords[name];
  const [x, y] = coords ? (projection(coords) ?? [0, 0]) : [0, 0];
  return {
    id: lugarId(name),
    name,
    x: Math.round(x * 10) / 10,
    y: Math.round(y * 10) / 10,
    left: ((x - full.x) / full.w) * 100,
    top: ((y - full.y) / full.h) * 100,
  };
};

const cities = trayectoria.colombia.map(place);

// Towns closer than this (map units, at the Colombia zoom) are too close to tap
// apart: they share one numbered marker that fans them out when tapped.
const CLUSTER_GAP = focus.w * 0.06;
const groups: (typeof cities)[] = [];
for (const city of cities) {
  const near = groups.find((group) =>
    group.some((other) => Math.hypot(other.x - city.x, other.y - city.y) < CLUSTER_GAP),
  );
  if (near) near.push(city);
  else groups.push([city]);
}
const clusters = groups
  .filter((group) => group.length > 1)
  .map((members, index) => {
    const x = members.reduce((sum, m) => sum + m.x, 0) / members.length;
    const y = members.reduce((sum, m) => sum + m.y, 0) / members.length;
    return {
      id: `grupo-${index}`,
      names: members.map((m) => m.name),
      ids: members.map((m) => m.id),
      x: Math.round(x * 10) / 10,
      y: Math.round(y * 10) / 10,
      left: ((x - full.x) / full.w) * 100,
      top: ((y - full.y) / full.h) * 100,
    };
  });
const clusterOf = new Map(clusters.flatMap((c) => c.ids.map((id) => [id, c.id] as const)));
const abroad = trayectoria.internacional.map(place);
const colombiaPin = place('Colombia');
---

<div
  class="mapa"
  data-mapa
  data-mode="latam"
  data-full={JSON.stringify(full)}
  data-focus={JSON.stringify(focus)}
  style={`aspect-ratio: ${full.w} / ${full.h};`}
>
  <svg
    class="mapa__svg"
    viewBox={`${full.x} ${full.y} ${full.w} ${full.h}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g class="mapa__land">
      {
        land.map((country) => (
          <path
            d={country.d}
            class:list={[
              'mapa__country',
              country.visited && 'mapa__country--visited',
              country.id === COLOMBIA_ID && 'mapa__country--colombia',
            ]}
            data-mapa-zoom={country.id === COLOMBIA_ID ? '' : undefined}
          />
        ))
      }
    </g>
    <!-- flight routes from Bogotá, drawn by the script -->
    <g class="mapa__vuelos" data-vuelos></g>
    <g class="mapa__avion" data-avion visibility="hidden">
      <path d="M14 0 C14 -1.4 12.6 -2 10 -2 L4 -2 L-3 -11 L-6.5 -11 L-2.5 -2 L-9 -2 L-12 -6 L-14.5 -6 L-12.5 0 L-14.5 6 L-12 6 L-9 2 L-2.5 2 L-6.5 11 L-3 11 L4 2 L10 2 C12.6 2 14 1.4 14 0 Z" />
    </g>
  </svg>

  <div class="mapa__pins">
    <div class="mapa__layer mapa__layer--paises" data-mapa-layer="latam">
      {
        abroad.map((pin) => (
          <button
            type="button"
            class="pin pin--pais"
            data-pin={pin.id}
            data-name={pin.name}
            data-x={pin.x}
            data-y={pin.y}
            style={`left: ${pin.left}%; top: ${pin.top}%;`}
          >
            <TapeX size={26} />
            <span class="visually-hidden">{pin.name}</span>
          </button>
        ))
      }
      <button
        type="button"
        class="pin pin--pais pin--colombia"
        data-mapa-zoom
        data-x={colombiaPin.x}
        data-y={colombiaPin.y}
        style={`left: ${colombiaPin.left}%; top: ${colombiaPin.top}%;`}
      >
        <TapeX size={30} />
        <span class="visually-hidden">Colombia: ver las ciudades de cerca</span>
      </button>
    </div>

    <div class="mapa__layer mapa__layer--ciudades" data-mapa-layer="colombia" inert>
      {
        cities.map((pin) => (
          <button
            type="button"
            class="pin pin--ciudad"
            data-pin={pin.id}
            data-cluster={clusterOf.get(pin.id)}
            data-name={pin.name}
            data-x={pin.x}
            data-y={pin.y}
            style={`left: ${pin.left}%; top: ${pin.top}%;`}
          >
            <Plus size={20} />
            <span class="visually-hidden">{pin.name}</span>
            <span class="pin__label display" aria-hidden="true">{pin.name}</span>
          </button>
        ))
      }
      {
        clusters.map((group) => (
          <button
            type="button"
            class="pin pin--grupo"
            data-grupo={group.id}
            data-x={group.x}
            data-y={group.y}
            aria-expanded="false"
            aria-label={`Ver por separado: ${group.names.join(', ')}`}
            style={`left: ${group.left}%; top: ${group.top}%;`}
          >
            <span class="display" aria-hidden="true">{group.names.length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="mapa__tag display" data-mapa-tag role="status" hidden></p>

  <button type="button" class="mapa__toggle display" data-mapa-toggle>
    <span data-mapa-toggle-label>Ver Colombia de cerca</span>
  </button>
</div>

<script>
  import '../scripts/mapa';
</script>

<style>
  .mapa {
    position: relative;
    width: 100%;
    user-select: none;
  }

  .mapa__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* soft edges where the zoomed view cuts through land */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }

  .mapa__country {
    fill: rgb(255 255 255 / 0.09);
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 0.6px;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  .mapa__country--visited {
    fill: var(--c-brick);
    stroke: rgb(255 255 255 / 0.5);
  }

  .mapa__country--colombia {
    fill: var(--c-red);
    cursor: zoom-in;
    transition: fill var(--dur-1) var(--ease-out);
  }

  .mapa__country--colombia:hover {
    fill: var(--c-red-hover);
  }

  .mapa[data-mode='colombia'] .mapa__country--colombia {
    fill: var(--c-brick);
    cursor: default;
  }

  /* up close, only Colombia stays lit */
  .mapa[data-mode='colombia'] .mapa__country--visited:not(.mapa__country--colombia) {
    fill: rgb(255 255 255 / 0.09);
    stroke: rgb(255 255 255 / 0.28);
  }

  .mapa__pins {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .mapa__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    transition:
      transform var(--dur-1) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  /* --fx/--fy fan a town out of its group; --s is the size step */
  .pin {
    transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(var(--s, 1));
  }

  .pin:hover,
  .pin.is-active {
    --s: 1.25;
  }

  .pin:focus-visible {
    outline-offset: 0;
  }

  .pin--colombia {
    cursor: zoom-in;
  }

  .pin--ciudad {
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    color: var(--c-white);
  }

  .pin--ciudad :global(.plus-mark) {
    color: var(--c-white);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.7));
    transition: color var(--dur-1) var(--ease-out);
  }

  .pin--ciudad.is-active :global(.plus-mark) {
    color: var(--c-navy-900);
  }

  .pin--ciudad.is-active {
    background-color: var(--c-paper);
    border-radius: 50%;
  }

  /* Overview: the cities show as a small cluster that is not yet clickable. */
  .mapa[data-mode='latam'] .pin--ciudad {
    --s: 0.4;
    opacity: 0.85;
    pointer-events: none;
  }

  /* grouped towns stay folded into their marker until it is tapped */
  .mapa[data-mode='colombia'] .pin[data-cluster]:not(.is-fanned) {
    --s: 0.3;
    opacity: 0;
    pointer-events: none;
  }

  .pin.is-fanned {
    z-index: 2;
  }

  /* a group is open: the other marks fade back so the fanned towns read on
     their own, but stay clickable and come back on hover */
  .mapa.has-fan .pin:not(.is-fanned):not([aria-expanded='true']) {
    opacity: 0.28;
  }

  .mapa.has-fan .pin:not(.is-fanned):not([aria-expanded='true']):hover,
  .mapa.has-fan .pin:not(.is-fanned):not([aria-expanded='true']):focus-visible {
    opacity: 1;
  }

  .mapa[data-mode='latam'] .pin--grupo {
    opacity: 0;
    pointer-events: none;
  }

  .pin--grupo {
    z-index: 1;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 2px solid var(--c-white);
    border-radius: 50%;
    background-color: var(--c-red);
    color: var(--c-white);
    font-size: 0.85rem;
    box-shadow: 0 3px 8px rgb(0 0 0 / 0.5);
  }

  /* open group: a quiet hub with a ring where its towns sit */
  .pin--grupo[aria-expanded='true'] {
    --s: 0.7;
    background-color: var(--c-navy-900);
  }

  .pin--grupo[aria-expanded='true']::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--ring, 128px);
    height: var(--ring, 128px);
    border: 1px dashed rgb(255 255 255 / 0.45);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .pin__label {
    position: absolute;
    top: 50%;
    left: 100%;
    display: none;
    padding: 0.15rem 0.4rem;
    background-color: rgb(13 17 33 / 0.85);
    color: var(--c-white);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .pin.is-fanned .pin__label {
    display: block;
  }

  .pin[data-label-side='left'] .pin__label {
    left: auto;
    right: 100%;
  }

  .pin.is-active .pin__label {
    background-color: var(--c-paper);
    color: var(--c-ink);
  }

  /* routes and the plane, in map units; strokes keep their screen width.
     Routes are created by the script, so they need :global to get these styles. */
  .mapa__vuelos :global(.mapa__vuelo) {
    fill: none;
    stroke: var(--c-white);
    stroke-width: 1.6px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.9;
    transition: opacity 1.2s var(--ease-out);
  }

  .mapa__vuelos :global(.mapa__vuelo.is-landed) {
    opacity: 0.4;
  }

  .mapa__vuelos :global(.mapa__vuelo.is-gone),
  .mapa[data-mode='colombia'] .mapa__vuelos :global(.mapa__vuelo.is-landed) {
    opacity: 0;
  }

  .mapa__avion path {
    fill: var(--c-white);
    stroke: var(--c-navy-900);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.5));
  }

  .mapa[data-mode='colombia'] .mapa__layer--paises .pin {
    opacity: 0;
    pointer-events: none;
  }

  .mapa__tag {
    position: absolute;
    z-index: 3;
    margin: 0;
    padding: 0.45rem 0.7rem 0.5rem;
    background-color: var(--c-paper);
    background-image: var(--tex-grain);
    color: var(--c-ink);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    line-height: 1.1;
    white-space: nowrap;
    box-shadow: var(--sh-paper);
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 20px)) rotate(-2deg);
  }

  .mapa__tag[data-align='start'] {
    transform: translate(-14px, calc(-100% - 20px)) rotate(-2deg);
  }

  .mapa__tag[data-align='end'] {
    transform: translate(calc(-100% + 14px), calc(-100% - 20px)) rotate(-2deg);
  }

  .mapa__tag[data-side='below'] {
    transform: translate(-50%, 22px) rotate(-2deg);
  }

  .mapa__tag[data-side='below'][data-align='start'] {
    transform: translate(-14px, 22px) rotate(-2deg);
  }

  .mapa__tag[data-side='below'][data-align='end'] {
    transform: translate(calc(-100% + 14px), 22px) rotate(-2deg);
  }

  .mapa__toggle {
    position: absolute;
    z-index: 4;
    bottom: var(--s-3);
    left: 0;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    border: 0;
    background-color: var(--c-white);
    color: var(--c-navy-900);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    cursor: pointer;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.35);
    transition:
      background-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .mapa__toggle:hover {
    background-color: var(--c-paper);
    transform: translateY(-2px);
  }
</style>
