---
import { Picture } from 'astro:assets';
import grupalDelito from '../assets/fotos/grupal-delito.webp';
import grupoBar from '../assets/fotos/grupo-bar.webp';
import tarimaKeytar from '../assets/fotos/tarima-keytar.webp';
import logoBlanco from '../assets/logo/logo-blanco.svg';
import fondoTarima from '../assets/muro/fondo-tarima.webp';
import { SPOTIFY_ARTIST_URL, WHATSAPP_BOOKING_URL } from '../config';
import { hero, trayectoria } from '../data/content';
import Button from './ui/Button.astro';
import Polaroid from './ui/Polaroid.astro';

const [subBefore, subAfter] = hero.subtitulo.split('+');

const lastDotIndex = hero.generos.lastIndexOf(' · ');
// Each genre is kept whole and the dot stays at the end of a line when it wraps.
const genres = hero.generos.slice(0, lastDotIndex).split(' · ');
const location = hero.generos.slice(lastDotIndex + 3);

// Only facts already published elsewhere on the page.
const tickerItems = [
  'Cumbia villera',
  'Cumbia urbana',
  location,
  'Desde 2012',
  'Tradición caribe colombiana',
  'Energía urbana latinoamericana',
  trayectoria.internacional.join(' · '),
];
---

<header id="top" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <Picture
      src={fondoTarima}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 1024, 1480]}
      sizes="100vw"
      width={fondoTarima.width}
      height={fondoTarima.height}
      alt=""
      loading="eager"
      class="hero__bg-img"
    />
  </div>

  <div class="hero__inner">
    <div class="hero__collage">
      <div class="hero__shot hero__shot--duo">
        <Polaroid
          src={tarimaKeytar}
          alt="Christian Delgado, fundador de Cumbia De+Lito, tocando un keytar blanco Roland en tarima, con gafas oscuras y la camiseta de la banda"
          loading="eager"
          fetchpriority="high"
          widths={[320, 480, 640, 800, 1000]}
          sizes="(max-width: 759px) 50vw, 32vw"
          rotate={-3}
          tape="top"
        />
      </div>
      <div class="hero__shot hero__shot--bar">
        <Polaroid
          src={grupalDelito}
          alt="La banda celebrando con el público al final de un show en un bar, con bajo y keytar rojo"
          loading="eager"
          widths={[256, 400, 512]}
          sizes="(max-width: 759px) 34vw, 20vw"
          rotate={5}
          tape="corners"
        />
      </div>
      <div class="hero__shot hero__shot--grupo">
        <Polaroid
          src={grupoBar}
          alt="La banda completa posando con sus instrumentos junto al telón de Cumbia De+Lito en un bar"
          loading="eager"
          widths={[256, 400, 512]}
          sizes="(max-width: 759px) 30vw, 16vw"
          rotate={-6}
          tape="top"
        />
      </div>
    </div>

    <div class="hero__copy">
      <img
        src={logoBlanco.src}
        alt="Cumbia De+Lito"
        width="1963"
        height="1234"
        fetchpriority="high"
        class="hero__logo"
      />

      <h1 class="hero__genres display">
        <span class="hero__genres-pair">
          {
            genres.map((genre, index) => (
              <span class="hero__genre">
                {genre}
                {index < genres.length - 1 && ' ·'}
              </span>
            ))
          }
        </span>
        <span class="hero__genres-place">{location}</span>
      </h1>

      <p class="hero__subtitle">
        {subBefore}<span class="hero__plus">+</span>{subAfter}
      </p>

      <div class="hero__ctas">
        <Button
          href={WHATSAPP_BOOKING_URL}
          variant="primary"
          icon="whatsapp"
          external
        >
          Contrata el show
        </Button>
        <Button
          href={SPOTIFY_ARTIST_URL}
          variant="secondary"
          icon="spotify"
          external
        >
          Escúchanos
        </Button>
      </div>
    </div>
  </div>

  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      {
        [0, 1].map(() => (
          <ul class="hero__ticker-run display" role="list">
            {tickerItems.map((item) => (
              <li>
                {item}
                <span class="hero__ticker-plus">+</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</header>

<style>
  .hero {
    --ticker-h: 52px;
    position: relative;
    z-index: 3;
    min-height: 100svh;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    background-color: var(--c-navy-900);
    overflow-x: clip;
  }

  /* ---------- the wall ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__bg :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Mirrored so the navy field sits behind the copy and the red/gray curves
     sit behind the photos. */
  .hero__bg :global(.hero__bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transform: scaleX(-1);
  }

  /* legibility scrim over the brick, strongest behind the copy */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(13 17 33 / 0.9) 0%,
        rgb(13 17 33 / 0.72) 36%,
        rgb(13 17 33 / 0.1) 64%,
        rgb(13 17 33 / 0) 100%
      ),
      linear-gradient(
        to top,
        rgb(13 17 33 / 0.7) 0%,
        rgb(13 17 33 / 0) 30%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4svh, 3rem) var(--gutter)
      clamp(2rem, 5svh, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
    grid-template-areas: 'copy collage';
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  /* ---------- copy ---------- */
  .hero__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.5rem, 1.4svh, 1rem);
  }

  /* 1.59 is the logo's width/height ratio; the cap on height keeps the CTAs
     inside the first screen on short laptops. */
  .hero__logo {
    width: min(100%, 560px, calc((100svh - 64px - var(--ticker-h) - 330px) * 1.59));
    min-width: 240px;
    height: auto;
    margin-left: -0.5rem;
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.55));
  }

  .hero__genres {
    font-size: calc(var(--t-label) * 1.3);
    letter-spacing: 0.2em;
    line-height: 1.3;
    color: var(--c-white);
  }

  .hero__genres-pair,
  .hero__genres-place {
    display: block;
  }

  .hero__genre {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__genre:not(:last-child) {
    margin-right: 0.6em;
  }

  .hero__genres-place {
    color: var(--c-text-soft);
    font-size: 0.88em;
    margin-top: 0.15rem;
  }

  .hero__subtitle {
    max-width: 30ch;
    font-size: var(--t-lead);
    line-height: 1.35;
    color: var(--c-white);
  }

  .hero__plus {
    color: var(--c-red);
    font-weight: 900;
    font-size: 1.3em;
    line-height: 1;
    padding-inline: 0.08em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .hero__ctas :global(.btn__label) {
    white-space: nowrap;
  }

  /* ---------- collage pasted on the wall ---------- */
  .hero__collage {
    grid-area: collage;
    position: relative;
    /* bounded by height too, so the pile never pushes past the fold */
    width: min(100%, 760px, calc((100svh - 64px - var(--ticker-h) - 4rem) / 0.86));
    justify-self: end;
    aspect-ratio: 1 / 0.86;
    container-type: size;
  }

  .hero__shot {
    position: absolute;
  }

  .hero__shot--duo {
    width: 64cqw;
    left: 18cqw;
    top: 2cqh;
    z-index: 2;
  }

  .hero__shot--bar {
    width: 40cqw;
    left: 0;
    bottom: 0;
    z-index: 3;
  }

  .hero__shot--grupo {
    width: 30cqw;
    right: 0;
    bottom: 8cqh;
    z-index: 4;
  }

  /* ---------- ticker ---------- */
  .hero__ticker {
    position: relative;
    z-index: 2;
    height: var(--ticker-h);
    background-color: var(--c-red);
    background-image: var(--tex-grain);
    border-top: 3px solid #000000;
    display: flex;
    align-items: center;
    /* clip the rolling text sideways */
    overflow-x: clip;
  }

  .hero__ticker-track {
    display: flex;
    flex-shrink: 0;
    width: max-content;
  }

  .hero__ticker-run {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__ticker-run li {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    letter-spacing: 0.14em;
    color: var(--c-white);
  }

  .hero__ticker-plus {
    padding-inline: 1.1em;
    color: var(--c-navy-900);
    font-size: 1.5em;
    line-height: 1;
  }

  /* ---------- motion: photos get slapped onto the wall, ticker rolls ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__shot {
      animation: hero-paste 0.55s var(--ease-out) backwards;
    }

    .hero__shot--duo {
      animation-delay: 0.1s;
    }

    .hero__shot--bar {
      animation-delay: 0.28s;
    }

    .hero__shot--grupo {
      animation-delay: 0.42s;
    }
    .hero__ticker-track {
      animation: hero-ticker 38s linear infinite;
    }

    .hero__ticker:hover .hero__ticker-track {
      animation-play-state: paused;
    }
  }

  @keyframes hero-paste {
    from {
      opacity: 0;
      transform: translateY(-18px) scale(1.12) rotate(-4deg);
    }
  }

  @keyframes hero-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- tablet ---------- */
  @media (max-width: 1080px) and (min-width: 760px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* ---------- phone ---------- */
  @media (max-width: 759.98px) {
    .hero {
      --ticker-h: 44px;
      padding-top: 56px;
    }

    .hero__bg :global(.hero__bg-img) {
      object-position: 30% center;
    }

    .hero__bg::after {
      background: linear-gradient(
        to bottom,
        rgb(13 17 33 / 0.25) 0%,
        rgb(13 17 33 / 0.55) 34%,
        rgb(13 17 33 / 0.9) 52%,
        rgb(13 17 33 / 0.94) 100%
      );
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'collage'
        'copy';
      align-content: start;
      gap: var(--s-4);
      padding-top: var(--s-5);
      padding-bottom: var(--s-6);
    }

    .hero__collage {
      width: 100%;
      aspect-ratio: 1 / 0.6;
    }

    .hero__shot--duo {
      width: 50cqw;
      left: 25cqw;
      top: 4cqh;
    }

    .hero__shot--bar {
      width: 33cqw;
      left: 0;
      top: 12cqh;
      bottom: auto;
      z-index: 1;
    }

    .hero__shot--grupo {
      width: 29cqw;
      right: 0;
      top: 8cqh;
      bottom: auto;
    }
    .hero__logo {
      width: min(76vw, 300px);
      min-width: 0;
      margin-left: -0.3rem;
    }

    .hero__ctas {
      width: 100%;
      flex-direction: column;
      gap: var(--s-2);
      margin-top: var(--s-2);
    }

    .hero__ctas :global(.btn) {
      width: 100%;
      min-height: 48px;
      padding: 0.75rem 1.1rem;
    }

    .hero__ticker-run li {
      font-size: 0.8rem;
    }
  }
</style>
