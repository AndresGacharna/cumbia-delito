---
import { Picture } from 'astro:assets';
import tarimaKeytar from '../assets/fotos/tarima-keytar.jpg';
import logoBlanco from '../assets/logo/logo-blanco.svg';
import fondoTarima from '../assets/muro/fondo-tarima.jpg';
import { SPOTIFY_ARTIST_URL, WHATSAPP_BOOKING_URL } from '../config';
import { hero, stageMarks, type StageMarkId } from '../data/content';
import Button from './ui/Button.astro';
import Polaroid from './ui/Polaroid.astro';
import TapeX from './ui/TapeX.astro';

const [subBefore, subAfter] = hero.subtitulo.split('+');

const heroMarkIds: StageMarkId[] = ['musica', 'show', 'organizadores'];
const heroMarks = heroMarkIds.map((id, index) => {
  const found = stageMarks.find((mark) => mark.id === id);
  return {
    id,
    label: found ? found.label : id,
    index,
  };
});
---

<header id="top" class="hero" data-stage-hero>
  <div class="hero__wall" aria-hidden="true">
    <Picture
      src={fondoTarima}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1480]}
      sizes="100vw"
      width={fondoTarima.width}
      height={fondoTarima.height}
      alt=""
      loading="eager"
      class="hero__wall-img"
    />
  </div>

  <div class="hero__floor">
    <div class="hero__stage">
      <div class="hero__polaroid">
        <Polaroid
          src={tarimaKeytar}
          alt="Músico de Cumbia De+Lito tocando un keytar blanco Roland en tarima, con gafas oscuras y la camiseta de la banda"
          loading="eager"
          fetchpriority="high"
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 760px) 44vw, 28vw"
          rotate={-4}
          tape="top"
        />
      </div>

      <div class="hero__marks" aria-label="Atajos en la tarima">
        {
          heroMarks.map((mark) => (
            <div
              class:list={['hero-mark', `hero-mark--${mark.id}`]}
              style={`--mark-index: ${mark.index};`}
            >
              <span class="hero-mark__x-wrap">
                <TapeX size={44} class="hero-mark__x" />
              </span>
              <svg
                class="hero-mark__leader"
                viewBox="0 0 36 12"
                aria-hidden="true"
              >
                <line
                  x1="0"
                  y1="6"
                  x2="36"
                  y2="6"
                  pathLength="1"
                  class="hero-mark__line"
                />
              </svg>
              <a href={`#${mark.id}`} class="hero-mark__label display">
                {mark.label}
              </a>
            </div>
          ))
        }
      </div>

      <div class="hero__front">
        <img
          src={logoBlanco.src}
          alt="Cumbia De+Lito"
          width="1963"
          height="1234"
          fetchpriority="high"
          class="hero__logo"
        />

        <h1 class="hero__genres display">{hero.generos}</h1>

        <p class="hero__subtitle">
          {subBefore}<span class="hero__plus">+</span>{subAfter}
        </p>

        <div class="hero__ctas">
          <Button
            href={WHATSAPP_BOOKING_URL}
            variant="primary"
            icon="whatsapp"
            external
          >
            Contrata el show
          </Button>
          <Button
            href={SPOTIFY_ARTIST_URL}
            variant="secondary"
            icon="spotify"
            external
          >
            Escúchanos
          </Button>
        </div>

        <div class="hero__mic-mark" aria-hidden="true">
          <TapeX size={44} class="hero-mark__x" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    --hero-wall: clamp(104px, 28svh, 300px);
    /* height taken by everything on the floor except the logo; feeds the logo size */
    --hero-rest: 300px;
    position: relative;
    min-height: 100svh;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    background-color: var(--c-navy-900);
    overflow: clip;
  }

  .hero__wall {
    position: relative;
    width: 100%;
    height: var(--hero-wall);
    border-bottom: 6px solid #000000;
    overflow: hidden;
    flex-shrink: 0;
  }

  .hero__wall :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* the red curve sits in the lower half of the photo: 62% keeps gray, navy and red in the band */
  .hero__wall :global(.hero__wall-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .hero__floor {
    position: relative;
    flex: 1;
    display: flex;
    background-color: var(--c-navy-900);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(9rem - 1px),
      rgb(255 255 255 / 0.025) calc(9rem - 1px),
      rgb(255 255 255 / 0.025) 9rem
    );
  }

  .hero__stage {
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hero__polaroid {
    position: absolute;
    left: clamp(1rem, 3.5vw, 4rem);
    top: -2.25rem;
    width: clamp(185px, 21vw, 310px);
    z-index: 2;
  }

  .hero__marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .hero-mark {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    pointer-events: auto;
  }

  .hero-mark--musica {
    top: 0.2rem;
    left: 44%;
  }

  .hero-mark--show {
    top: 24%;
    right: clamp(1rem, 3vw, 3.5rem);
  }

  .hero-mark--organizadores {
    top: 58%;
    right: clamp(1rem, 3vw, 3.5rem);
  }

  .hero-mark__x-wrap {
    display: inline-flex;
    flex-shrink: 0;
  }

  .hero-mark__leader {
    width: 32px;
    height: 12px;
    flex-shrink: 0;
    overflow: visible;
  }

  .hero-mark__line {
    stroke: rgb(255 255 255 / 0.7);
    stroke-width: 1.5px;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hero-mark__label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.2rem;
    font-size: var(--t-label);
    letter-spacing: 0.16em;
    color: var(--c-white);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .hero-mark__label:hover,
  .hero-mark__label:focus-visible {
    color: var(--c-white);
    text-decoration: underline;
    text-decoration-color: var(--c-red);
    text-decoration-thickness: 2px;
    transform: translateX(2px);
  }

  .hero__front {
    position: relative;
    z-index: 2;
    /* clears the "Música" mark that sits at the back of the floor */
    margin-top: 3.25rem;
    margin-left: clamp(205px, 24.5vw, 370px);
    margin-right: clamp(210px, 21vw, 310px);
    padding-bottom: var(--s-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.25rem, 0.8svh, 0.65rem);
  }

  /* 1.59 is the logo's width/height ratio; the logo shrinks with the viewport
     height so the CTAs always stay inside the first screen. */
  .hero__logo {
    width: max(
      220px,
      min(
        40vw,
        calc((100svh - 64px - var(--hero-wall) - var(--hero-rest)) * 1.59),
        600px
      )
    );
    max-width: 100%;
    height: auto;
  }

  .hero__genres {
    font-size: calc(var(--t-label) * 1.25);
    letter-spacing: 0.22em;
    color: var(--c-white);
    line-height: 1.2;
  }

  .hero__subtitle {
    font-size: var(--t-lead);
    color: var(--c-white);
    line-height: 1.3;
    max-width: 38ch;
  }

  .hero__plus {
    color: var(--c-red);
    font-weight: 900;
    font-size: var(--t-h3);
    line-height: 1;
    padding-inline: 0.1em;
  }

  .hero__ctas {
    display: grid;
    grid-template-columns: repeat(2, minmax(max-content, 1fr));
    gap: var(--s-4);
    width: max-content;
    margin-top: clamp(0.15rem, 0.6svh, 0.5rem);
  }

  .hero__ctas :global(.btn__label) {
    white-space: nowrap;
  }

  .hero__mic-mark {
    display: flex;
    justify-content: center;
    margin-top: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-mark__x-wrap {
      animation: hero-mark-slap 0.45s var(--ease-out) backwards;
      animation-delay: calc(0.3s + var(--mark-index, 0) * 0.09s);
    }

    .hero-mark__line {
      animation: hero-line-draw 0.6s var(--ease-out) backwards;
      animation-delay: calc(0.75s + var(--mark-index, 0) * 0.09s);
    }

    .hero-mark__label {
      animation: hero-label-fade 0.3s var(--ease-out) backwards;
      animation-delay: calc(1.35s + var(--mark-index, 0) * 0.09s);
    }
  }

  @keyframes hero-mark-slap {
    from {
      opacity: 0;
      transform: scale(1.25) rotate(-8deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes hero-line-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-label-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) and (min-width: 760px) {
    .hero__polaroid {
      width: clamp(160px, 19vw, 220px);
    }

    .hero__front {
      margin-left: clamp(175px, 22vw, 240px);
      margin-right: clamp(195px, 24vw, 250px);
    }

    .hero-mark__leader {
      width: 18px;
    }
  }

  @media (max-width: 759.98px) {
    .hero {
      padding-top: 56px;
    }

    .hero__wall {
      height: clamp(92px, 14svh, 128px);
    }

    .hero__stage {
      --pol-w: min(42vw, 172px);
      padding-top: var(--s-2);
      padding-bottom: var(--s-3);
    }

    .hero__polaroid {
      left: auto;
      right: var(--gutter);
      top: -3.25rem;
      width: var(--pol-w);
    }

    .hero__polaroid :global(.polaroid) {
      transform: rotate(4deg);
    }

    /* "Música" and "El show" sit left of the polaroid; "Organizadores" is too
       wide for that gap, so it takes the row below the polaroid's bottom edge. */
    .hero__marks {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
      min-height: calc(var(--pol-w) * 1.05 - 1rem);
      margin-bottom: var(--s-2);
    }

    .hero-mark {
      position: static;
      gap: 0.25rem;
    }

    .hero-mark--organizadores {
      margin-top: auto;
    }

    .hero__floor :global(.hero-mark__x) {
      width: 30px;
      height: 30px;
    }

    .hero-mark__leader {
      width: 16px;
    }

    .hero-mark__label {
      min-height: 38px;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
    }

    .hero__front {
      margin: 0;
      align-items: flex-start;
      text-align: left;
      gap: 0.45rem;
    }

    .hero__logo {
      width: 260px;
      max-width: 100%;
    }

    .hero__ctas {
      max-width: none;
      gap: var(--s-2);
    }

    .hero__mic-mark {
      align-self: center;
      margin-top: 0.25rem;
    }
  }

  @media (max-width: 700px) {
    .hero__ctas {
      width: 100%;
      grid-template-columns: 1fr;
    }

    .hero__ctas :global(.btn) {
      min-height: 46px;
      padding: 0.75rem 1.1rem;
      width: 100%;
    }
  }
</style>
