---
export interface Props {
  size?: number; // px width, default 64
  class?: string;
  title?: string;
}

const { size = 64, class: className, title } = Astro.props;

// 25 white keys (indices 0..24)
const whiteKeyCount = 25;
const kbX = 18;
const kbY = 16;
const kbW = 90;
const kbH = 18;
const keyW = kbW / whiteKeyCount; // 3.6px

const whiteDividers = Array.from(
  { length: whiteKeyCount - 1 },
  (_, i) => Math.round((kbX + (i + 1) * keyW) * 10) / 10
);

// Standard 2-octave Roland AX black key pattern (C# D# F# G# A#)
const blackKeyIndices = [1, 2, 4, 5, 6, 8, 9, 11, 12, 13, 15, 16, 18, 19, 20, 22, 23];
const blackKeys = blackKeyIndices.map((idx) => {
  const cx = kbX + idx * keyW;
  return {
    x: Math.round((cx - 1.2) * 10) / 10,
    y: kbY,
    w: 2.4,
    h: 11,
  };
});

const height = Math.round((size * 52) / 160);
---

<svg
  viewBox="0 0 160 52"
  width={size}
  height={height}
  class:list={['keytar', className]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}

  <!-- Strap peg (left end) -->
  <path
    d="M 8 23.5 L 4 23.5 C 3 23.5 3 28.5 4 28.5 L 8 28.5 Z"
    fill="#FFFFFF"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
    stroke-linejoin="round"
  />

  <!-- Main body with long neck on the right -->
  <path
    d="M 8 19 L 18 11 L 112 11 L 115 14 L 153 16 C 157 16 158 19 158 24 C 158 28 156 31 152 31 L 122 31 L 114 42 L 22 42 L 14 34 L 8 34 Z"
    fill="#FFFFFF"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
    stroke-linejoin="round"
  />

  <!-- Neck handle grip cutout -->
  <rect
    x="122"
    y="21"
    width="22"
    height="5.5"
    rx="2.75"
    fill="var(--c-navy-900)"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
  />

  <!-- Neck ribbon controller -->
  <line
    x1="124"
    y1="16.5"
    x2="148"
    y2="16.5"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
    stroke-linecap="round"
  />

  <!-- Neck modulation button -->
  <circle cx="152" cy="23.5" r="1.5" fill="var(--c-navy-900)" />

  <!-- Lower body bevel crease line -->
  <line
    x1="16"
    y1="36"
    x2="112"
    y2="36"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
    stroke-linecap="round"
  />

  <!-- Top display / control strip -->
  <rect
    x="94"
    y="12.5"
    width="14"
    height="2.5"
    rx="0.5"
    fill="var(--c-navy-900)"
  />

  <!-- Keyboard base outline -->
  <rect
    x={kbX}
    y={kbY}
    width={kbW}
    height={kbH}
    fill="#FFFFFF"
    stroke="var(--c-navy-900)"
    stroke-width="1.5"
  />

  <!-- White key vertical dividers -->
  {
    whiteDividers.map((x) => (
      <line
        x1={x}
        y1={kbY}
        x2={x}
        y2={kbY + kbH}
        stroke="var(--c-navy-900)"
        stroke-width="1.5"
      />
    ))
  }

  <!-- Black keys -->
  {
    blackKeys.map((k) => (
      <rect
        x={k.x}
        y={k.y}
        width={k.w}
        height={k.h}
        fill="var(--c-navy-900)"
        stroke="var(--c-navy-900)"
        stroke-width="1"
        rx="0.5"
      />
    ))
  }
</svg>

<style>
  .keytar {
    display: inline-block;
    flex-shrink: 0;
  }
</style>
