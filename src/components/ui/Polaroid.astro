---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tape from './Tape.astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  rotate?: number;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
  tape?: 'top' | 'corners' | 'none';
  class?: string;
}

const {
  src,
  alt,
  caption,
  rotate = 0,
  widths,
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  tape = 'top',
  class: className,
} = Astro.props;
---

<figure
  class:list={[
    'polaroid',
    caption ? 'polaroid--has-caption' : 'polaroid--no-caption',
    className,
  ]}
  style={rotate !== 0 ? `--polaroid-rotate: ${rotate}deg;` : undefined}
>
  {tape === 'top' && <Tape class="polaroid__tape polaroid__tape--top" angle={-2} />}
  {
    tape === 'corners' && (
      <>
        <Tape class="polaroid__tape polaroid__tape--tl" angle={-36} />
        <Tape class="polaroid__tape polaroid__tape--tr" angle={34} />
      </>
    )
  }
  <div class="polaroid__photo">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      width={src.width}
      height={src.height}
      loading={loading}
      fetchpriority={fetchpriority}
      class="polaroid__img"
    />
  </div>
  {caption && <figcaption class="polaroid__caption display">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    --c-focus: var(--c-ink);
    container-type: inline-size;
    position: relative;
    display: block;
    padding: 4% 4% 0;
    background-color: var(--c-white);
    color: var(--c-ink);
    box-shadow: var(--sh-paper);
    transform: rotate(var(--polaroid-rotate, 0deg));
  }

  .polaroid--no-caption::after,
  .polaroid:not(:has(.polaroid__caption))::after {
    content: '';
    display: block;
    padding-bottom: 14cqw;
  }

  .polaroid__photo {
    position: relative;
    overflow: hidden;
    background-color: var(--c-navy-900);
  }

  .polaroid :global(.polaroid__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .polaroid__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.55em 0.25em 0.8em;
    min-height: 2.6em;
    font-size: clamp(11px, 5.8cqw, var(--t-small));
    line-height: 1.15;
    color: var(--c-ink);
    box-sizing: border-box;
  }

  .polaroid :global(.polaroid__tape--top) {
    top: -0.85rem;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
  }

  .polaroid :global(.polaroid__tape--tl) {
    top: -0.45rem;
    left: -1.35rem;
    width: 5.25rem;
  }

  .polaroid :global(.polaroid__tape--tr) {
    top: -0.45rem;
    right: -1.35rem;
    width: 5.25rem;
  }
</style>
