---
// Old explorer's-map route lines behind a section: dashed ink trails that wind
// across the page, a dotted start, an X where they end, and a small compass
// rose. Faint on purpose; it is texture, not content.
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['rutas', className]}
  viewBox="0 0 1440 800"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g class="rutas__trail">
    <path d="M-40 640 C 140 560, 210 700, 360 620 S 560 430, 700 500 S 930 690, 1080 560 S 1300 300, 1480 360" />
    <path d="M-30 150 C 160 220, 260 60, 430 120 S 640 300, 820 210 S 1020 40, 1180 130 S 1380 260, 1470 190" />
    <path class="rutas__trail--thin" d="M220 820 C 260 700, 180 600, 300 520 S 460 380, 420 260 S 520 80, 640 -20" />
  </g>

  <!-- start dots and the X where each trail arrives -->
  <g class="rutas__marks">
    <circle cx="360" cy="620" r="6" />
    <circle cx="820" cy="210" r="6" />
    <path d="M1066 546 l28 28 M1094 546 l-28 28" />
    <path d="M1166 116 l24 24 M1190 116 l-24 24" />
  </g>

  <!-- compass rose -->
  <g class="rutas__rosa" transform="translate(1290 650)">
    <circle r="58" />
    <circle r="40" class="rutas__rosa-inner" />
    <path d="M0 -74 L9 0 L0 74 L-9 0 Z M-74 0 L0 -9 L74 0 L0 9 Z" />
    <path class="rutas__rosa-minor" d="M-40 -40 L5 -5 L40 40 L-5 5 Z M40 -40 L5 5 L-40 40 L-5 -5 Z" />
    <text y="-84" text-anchor="middle">N</text>
  </g>
</svg>

<style>
  .rutas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--c-paper);
    opacity: 0.16;
  }

  .rutas__trail path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-dasharray: 2 14;
    stroke-linecap: round;
  }

  .rutas__trail .rutas__trail--thin {
    stroke-width: 1.6;
    stroke-dasharray: 10 10;
  }

  .rutas__marks circle {
    fill: currentColor;
  }

  .rutas__marks path {
    fill: none;
    stroke: var(--c-red);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .rutas__rosa circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .rutas__rosa .rutas__rosa-inner {
    stroke-dasharray: 3 5;
  }

  .rutas__rosa path {
    fill: currentColor;
  }

  .rutas__rosa .rutas__rosa-minor {
    opacity: 0.6;
  }

  .rutas__rosa text {
    fill: currentColor;
    font-family: var(--f-sans);
    font-size: 22px;
    font-weight: 900;
  }

  @media (max-width: 759.98px) {
    .rutas {
      opacity: 0.12;
    }

    .rutas__rosa {
      display: none;
    }
  }
</style>
