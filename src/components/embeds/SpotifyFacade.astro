---
// TODO: unused since Música became the record crate; delete (see src/pages/index.astro).
import Icon from '../ui/Icon.astro';

export interface Props {
  trackId: string;
  title: string;
  artist?: string;
}

const { trackId, title, artist = 'Cumbia De+Lito' } = Astro.props;

const embedUrl = `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`;
const trackUrl = `https://open.spotify.com/track/${trackId}`;
---

<div class="spotify-facade" data-artist={artist}>
  <div class="spotify-facade__host" data-embed-host>
    <button
      type="button"
      class="spotify-facade__btn"
      data-embed="spotify"
      data-src={embedUrl}
      data-embed-title={`${title} en Spotify`}
      aria-label={`Escuchar ${title} aquí (carga el reproductor de Spotify)`}
    >
      <span class="spotify-facade__play" aria-hidden="true">
        <Icon name="play" size={16} />
      </span>
      <span class="spotify-facade__label">Escuchar aquí</span>
    </button>
  </div>
  <a
    href={trackUrl}
    target="_blank"
    rel="noopener"
    class="spotify-facade__link"
  >
    <span>Abrir en Spotify</span>
    <Icon name="external" size={14} />
  </a>
</div>

<script>
  import '../../scripts/embeds';
</script>

<style>
  .spotify-facade {
    display: grid;
    gap: var(--s-2);
    width: 100%;
  }

  .spotify-facade__host {
    width: 100%;
  }

  .spotify-facade__host :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
    background-color: var(--c-navy-900);
  }

  .spotify-facade__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    width: 100%;
    min-height: 48px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid rgb(255 255 255 / 0.22);
    background-color: var(--c-navy-900);
    color: var(--c-white);
    font-family: var(--f-sans);
    font-size: var(--t-small);
    font-stretch: 112%;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .spotify-facade__btn:hover {
    background-color: var(--c-navy-700);
    border-color: var(--c-white);
    transform: translateY(-1px);
  }

  .spotify-facade__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background-color: var(--c-red);
    color: var(--c-white);
    flex-shrink: 0;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .spotify-facade__btn:hover .spotify-facade__play {
    background-color: var(--c-red-hover);
  }

  .spotify-facade__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    justify-self: start;
    min-height: 44px;
    padding-block: var(--s-2);
    font-size: var(--t-small);
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .spotify-facade__link:hover {
    opacity: 0.8;
    text-decoration-thickness: 2px;
  }
</style>
