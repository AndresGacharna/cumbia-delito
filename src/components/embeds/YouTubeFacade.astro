---
import Icon from '../ui/Icon.astro';
import Plus from '../ui/Plus.astro';

export interface Props {
  videoId: string;
  title: string;
  start?: number;
  thumbnail?: boolean;
}

const { videoId, title, start, thumbnail = true } = Astro.props;

const startParam = typeof start === 'number' && start > 0 ? `&start=${start}` : '';
const watchStartParam = typeof start === 'number' && start > 0 ? `&t=${start}` : '';
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0${startParam}`;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}${watchStartParam}`;
const thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="yt-facade">
  <div class="yt-facade__box" data-embed-host>
    <button
      type="button"
      class:list={[
        'yt-facade__btn',
        !thumbnail && 'yt-facade__btn--navy',
      ]}
      data-embed="youtube"
      data-src={embedUrl}
      data-embed-title={title}
      aria-label={`Ver ${title} (carga el video de YouTube)`}
    >
      {
        thumbnail ? (
          <>
            <img
              src={thumbnailUrl}
              loading="lazy"
              alt=""
              width="480"
              height="360"
              class="yt-facade__thumb"
            />
            <span class="yt-facade__scrim" aria-hidden="true" />
            <span class="yt-facade__play" aria-hidden="true">
              <Icon name="play" size={32} />
            </span>
          </>
        ) : (
          <span class="yt-facade__navy-face">
            <span class="yt-facade__face-title display">La Premiere · 2025</span>
            <span class="yt-facade__play" aria-hidden="true">
              <Icon name="play" size={32} />
            </span>
            <span class="yt-facade__pluses" aria-hidden="true">
              <Plus size={18} />
              <Plus size={18} />
              <Plus size={18} />
            </span>
          </span>
        )
      }
    </button>
  </div>
  <div class="yt-facade__links">
    <a
      href={watchUrl}
      target="_blank"
      rel="noopener"
      class="yt-facade__link"
    >
      <span>Ver en YouTube</span>
      <Icon name="external" size={14} />
    </a>
    <slot name="links" />
  </div>
</div>

<script>
  import '../../scripts/embeds';
</script>

<style>
  .yt-facade {
    display: grid;
    gap: var(--s-2);
    width: 100%;
  }

  .yt-facade__box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--c-navy-800);
    box-shadow: var(--sh-paper);
    overflow: hidden;
  }

  .yt-facade__box :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-facade__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.16);
    background-color: var(--c-navy-800);
    color: var(--c-white);
    cursor: pointer;
    overflow: hidden;
  }

  .yt-facade__btn:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: -3px;
  }

  .yt-facade__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .yt-facade__btn:hover .yt-facade__thumb {
    transform: scale(1.03);
  }

  .yt-facade__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgb(13 17 33 / 0.25) 0%,
      rgb(13 17 33 / 0.65) 100%
    );
  }

  .yt-facade__navy-face {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    align-items: center;
    justify-items: center;
    width: 100%;
    height: 100%;
    padding: var(--s-2) var(--s-3);
    background-color: var(--c-navy-800);
  }

  .yt-facade__face-title {
    align-self: end;
    padding-bottom: var(--s-2);
    font-size: var(--t-h3);
    color: var(--c-white);
    letter-spacing: 0.08em;
    text-align: center;
  }

  .yt-facade__pluses {
    align-self: start;
    padding-top: var(--s-2);
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
  }

  .yt-facade__play {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background-color: var(--c-red);
    color: var(--c-white);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.45);
    transition:
      transform var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .yt-facade__btn:hover .yt-facade__play,
  .yt-facade__btn:focus-visible .yt-facade__play {
    transform: scale(1.08);
    background-color: var(--c-red-hover);
  }

  .yt-facade__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
  }

  .yt-facade__link,
  .yt-facade__links :global(a) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding-block: var(--s-2);
    font-size: var(--t-small);
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .yt-facade__link:hover,
  .yt-facade__links :global(a:hover) {
    opacity: 0.8;
    text-decoration-thickness: 2px;
  }
</style>
