---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Propuesta from '../components/sections/Propuesta.astro';
import Musica from '../components/sections/Musica.astro';
import Colaboraciones from '../components/sections/Colaboraciones.astro';
import Historia from '../components/sections/Historia.astro';
import Show from '../components/sections/Show.astro';
import Trayectoria from '../components/sections/Trayectoria.astro';
import Organizadores from '../components/sections/Organizadores.astro';
import Contratacion from '../components/sections/Contratacion.astro';
import Footer from '../components/Footer.astro';
import WhatsAppChat from '../components/WhatsAppChat.astro';
import WallBand from '../components/ui/WallBand.astro';
import Tendedero from '../components/ui/Tendedero.astro';
import duoKeytar from '../assets/fotos/duo-keytar.webp';
import grupoSoundCity from '../assets/fotos/grupo-sound-city.webp';
import enVivoBar from '../assets/fotos/en-vivo-bar.webp';
import grupoBar from '../assets/fotos/grupo-bar.webp';
import grupoPublicoTarima from '../assets/fotos/grupo-publico-tarima.webp';
import festivalArgentinaBogota from '../assets/fotos/festival-argentina-bogota.webp';
import enVivoBarbaros from '../assets/fotos/en-vivo-barbaros.webp';
import '../styles/sections.css';
---

<Layout>
  <Nav />
  <Hero />
  <main>
    <Propuesta />
    <WallBand
      variant="fondo-tarima"
      position="center 65%"
      height="clamp(400px, 40vw, 580px)"
      muted
    >
      <Tendedero
        titulo="Pruebas del delito"
        bajada="Momentos de tarima en tarima, colgados para que no se olviden."
        fotos={[
          { src: duoKeytar, alt: 'Dos músicos posando frente a un fondo naranja; uno lleva un keytar blanco y la camiseta de Cumbia De+Lito' },
          { src: festivalArgentinaBogota, alt: 'La banda tocando con camisetas de Argentina en el festival ¡Argentina en el corazón de Bogotá!' },
          { src: grupoSoundCity, alt: 'Cuatro integrantes de Cumbia De+Lito con sus instrumentos en un escenario bajo un letrero de Sound City' },
          { src: grupoPublicoTarima, alt: 'La banda en tarima con el público detrás, en un festival al aire libre' },
          { src: enVivoBarbaros, alt: 'La banda tocando en vivo frente al público en Bárbaros Brewing Co.' },
          { src: enVivoBar, alt: 'La banda tocando en vivo en un bar, con guitarra, keytar blanco y el telón de Cumbia De+Lito' },
          { src: grupoBar, alt: 'La banda completa posando con sus instrumentos junto al telón de Cumbia De+Lito en un bar' },
        ]}
      />
    </WallBand>
    <Musica />
    <Colaboraciones />
    <WallBand
      variant="franja-roja"
      position="center 36%"
      stencil
    />
    <Historia />
    <Trayectoria />
    <Show />
    <WallBand
      variant="franja-gris"
      position="center 92%"
    />
    <Organizadores />
    <Contratacion />
  </main>
  <Footer />
  <WhatsAppChat />
</Layout>
